# OpenApplyPilot Environment Configuration
# Copy to ~/.openapplypilot/.env and fill in your values.

# Default LLM provider: openai, anthropic, gemini, or ollama
OPENAPPLYPILOT_LLM_PROVIDER=openai
OPENAPPLYPILOT_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Configure other providers as needed. Multiple keys are allowed when an
# explicit default provider is set above.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional per-stage routing. Stages: discover, enrich, score, tailor, cover.
# OPENAPPLYPILOT_SCORE_PROVIDER=openai
# OPENAPPLYPILOT_SCORE_MODEL=gpt-4o-mini
# OPENAPPLYPILOT_TAILOR_PROVIDER=anthropic
# OPENAPPLYPILOT_TAILOR_MODEL=claude-sonnet-4-5

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
